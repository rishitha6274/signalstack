# ---------------------------------------------------------------------------
# Signal Stack — environment
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Hindsight Cloud API key (starts with hsk_). Get it from the Connect page:
# https://ui.hindsight.vectorize.io  ->  "Connect"  ->  API key
HINDSIGHT_API_KEY=

# Hindsight Cloud API host. The API lives on api.*, the dashboard on ui.*.
# Leave this as-is for Cloud; set http://localhost:8888 for a self-hosted server.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Groq API key. https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# How many signals may enter ONE prompt. A bank with more signals than this is
# read as a window: the most recent ones, and the prompt says how many older
# ones are missing, so a read can never present a slice as a whole timeline.
# 0 is rejected — it would produce an empty prompt rather than a smaller one.
# MAX_SIGNALS_IN_PROMPT=40

# Ceiling on how many pages of memory are paged through to build one timeline.
# The timeline is read in full, not as a top-k slice; this only bounds a bank
# that has grown without limit.
# MAX_TIMELINE_PAGES=50

# Where the Streamlit UI finds the FastAPI API.
# Leave unset for local development (both on one host, UI on 8501, API on
# 8000) and the UI falls back to http://localhost:8000.
# Set this on a deployed UI to the backend's public URL, e.g.
#   BACKEND_URL=https://signalstack-backend.onrender.com
# The single-image Docker path does not need it: the UI reaches the API over
# loopback inside the container, which SIGNAL_STACK_API below already covers.
# BACKEND_URL=

# Optional write key. Leave unset locally: writes stay open, which is what
# two processes on one host need. Set it on a DEPLOYED API, because the
# backend binds 0.0.0.0 there and POST /signals and POST /competitors write to
# Hindsight on your account — an open public write endpoint is someone else's
# bill. Clients then send it as the X-API-Key header.
# Reads stay open either way: the seeded competitor intelligence is not
# private, and gating reads would only add friction to the demo.
# Set the SAME value on the frontend so it can send the header.
# API_KEY=

# Whether POST /demo/reset exists. It DELETES every competitor's memory bank,
# irreversibly, for everyone using the deployment — so the route is absent
# (404) unless this is 1, and the UI hides its reset button to match. Set 1
# only for a throwaway demo instance. If you leave it 0, restore the demo data
# from a terminal instead:
#   python scripts/seed_data.py --reset --verify
# The write key above is a SECOND gate on this route, not the only one: with
# API_KEY unset, that check is a no-op.
# ENABLE_DEMO_RESET=0

# Where the local competitor registry (slug -> display name) is kept
DATA_DIR=./data

# Seed the Hindsight banks from data/seed_signals.json on first start.
# Off by default so a local checkout starts empty and you choose to seed.
# The Dockerfile and render.yaml set this to 1 so a fresh deploy bootstraps.
# AUTOSEED=1
